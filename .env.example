# ─── Frete ────────────────────────────────────────────────────────────────────
# CEP de onde os pôsteres são despachados (só dígitos ou com traço).
SHIPPING_ORIGIN_CEP=

# Melhor Envio: cotar é gratuito e não exige contrato com os Correios.
# Token em Configurações > Tokens no painel (produção) ou no painel de sandbox.
MELHOR_ENVIO_TOKEN=
# "true" usa https://sandbox.melhorenvio.com.br (para testar sem cobrar nada).
MELHOR_ENVIO_SANDBOX=false
# A API exige identificar a aplicação com um contato técnico.
MELHOR_ENVIO_USER_AGENT=Guardei (contato@guardei.art)

# ─── Demais variáveis já usadas pelo projeto ──────────────────────────────────
# (listadas para referência; os valores ficam no .env.local, fora do git)
# NEXT_PUBLIC_BASE_URL=
# NEXT_PUBLIC_MAPBOX_TOKEN=
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# NEXT_PUBLIC_FIREBASE_APP_ID=
# FIREBASE_ADMIN_PROJECT_ID=
# FIREBASE_ADMIN_CLIENT_EMAIL=
# FIREBASE_ADMIN_PRIVATE_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# RESEND_API_KEY=
